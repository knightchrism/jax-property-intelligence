# Copy to .env (gitignored). Never use the postgres superuser here.
# The loaders write, so they use jax_loader (created by sql/roles.sql); read-only tools should use jax_reader.
DB_USER=jax_loader
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
DB_NAME=jax_property
# Optional: Duval parcel shapefile (default .\data\raw\Parcels.shp)
# PARCELS_PATH=C:\dev\jax-property-intelligence\data\raw\Parcels.shp
